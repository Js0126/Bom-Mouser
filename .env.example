# 複製這個檔案為 .env,並填入你自己的 API 憑證。
# .env 已被 .gitignore 排除,不會被提交進版控。
#
# 取得 Mouser Key: https://www.mouser.com/api-search/ (需申請 Search API 存取權限)

MOUSER_SEARCH_API_KEY=your_mouser_search_api_key_here

# 取得 DigiKey Client ID/Secret: https://developer.digikey.com/products/product-information-v4
# (申請 App 時選 Product Information V4,用 Client Credentials / 2-legged OAuth)
# 這兩個是選填 —— 沒設定的話,Mouser 查無結果的料件就不會嘗試查 DigiKey。
DIGIKEY_CLIENT_ID=your_digikey_client_id_here
DIGIKEY_CLIENT_SECRET=your_digikey_client_secret_here

# ---------------------------------------------------------------------------
# 以下全部選用,不設定則使用程式內建預設值(括號裡是預設)
# ---------------------------------------------------------------------------

# 查詢節流與重試
# MOUSER_RATE_LIMIT_SECONDS=1.0        # 每次請求間隔秒數;開始遇到限流就調高
# MOUSER_MAX_RETRIES=3                 # 逾時/429/5xx 的指數退避重試次數
# MOUSER_REQUEST_TIMEOUT_SECONDS=20    # 單次 HTTP 請求逾時秒數

# 比對信心分數門檻:低於此值標記為 needs_human_review
# MATCH_CONFIDENCE_THRESHOLD=0.7

# DigiKey 地區設定 —— 預設是台灣/台幣。
# **人在台灣以外的話這三個八成要改**,不然 DigiKey 會回你 TWD 報價。
# 例如美國:SITE=US, CURRENCY=USD;德國:SITE=DE, CURRENCY=EUR。
# (Mouser 的幣別是綁在你的 Mouser 帳號設定上,不由這裡控制。)
# DIGIKEY_LOCALE_SITE=TW
# DIGIKEY_LOCALE_LANGUAGE=en
# DIGIKEY_LOCALE_CURRENCY=TWD
